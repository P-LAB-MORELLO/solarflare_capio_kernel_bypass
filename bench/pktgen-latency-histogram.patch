                 if (lat->max_cycles == 0 || cycles > lat->max_cycles)
                     lat->max_cycles = cycles;
 
+                /* Histogram for percentile reporting. Bucket width is fixed
+                 * in nanoseconds; convert cycles once using the TSC rate. */
+                {
+                    uint64_t hz = rte_get_timer_hz();
+                    if (hz != 0) {
+                        uint64_t ns  = (cycles * 1000000000ULL) / hz;
+                        uint64_t idx = ns / PKTGEN_LAT_HIST_BUCKET_NS;
+                        if (idx < PKTGEN_LAT_HIST_BUCKETS)
+                            lat->hist[idx]++;
+                        else
+                            lat->hist_overflow++;
+                        lat->hist_count++;
+                    }
+                }
+
                 jitter = (cycles > lat->prev_cycles) ? cycles - lat->prev_cycles
                                                      : lat->prev_cycles - cycles;
                 if (jitter > lat->jitter_threshold_cycles)
diff --git a/app/pktgen.h b/app/pktgen.h
index 728eecd..f09f586 100644
--- a/app/pktgen.h
+++ b/app/pktgen.h
@@ -419,6 +419,19 @@ typedef struct {
 
 #define TSTAMP_MAGIC 0xf00dcafe
 
+/* Inline latency stamp carried in ordinary data packets.
+ *
+ * Placed immediately after Ethernet+IPv4+UDP (offset 42) and kept to 12 bytes
+ * so it fits a 64-byte frame, which has only 22 payload bytes. pktgen's own
+ * 24-byte tstamp_t at offset 48 cannot fit there, and 64B is the frame size
+ * that matters most for a packets-per-second benchmark.
+ */
+#define PKTGEN_INLINE_TS_OFFSET  42
+typedef struct inline_tstamp_s {
+    uint32_t magic;
+    uint64_t timestamp;
+} __attribute__((packed)) inline_tstamp_t;
+
